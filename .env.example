# Copy to .env, or run "npm run setup" to fill this in for you.

# Required. Create a bot with @BotFather in Telegram (/newbot) and paste its token.
TELEGRAM_BOT_TOKEN=

# Where files are posted in Telegram. Recommended: a private channel with the bot as an
# admin (allowed to post and delete messages). Channel ids look like -1001234567890.
# Leave empty to store each person's files in their own private chat with the bot.
TELEGRAM_STORAGE_CHAT_ID=

# Telegram user ids that may sign in, separated by commas. Empty = anyone who finds the bot
# can sign in (everyone still only sees their own files). "npm run setup" can find your id.
ALLOWED_TELEGRAM_USER_IDS=

# Web server. Use HOST=0.0.0.0 to reach it from other devices on your network.
PORT=8080
HOST=127.0.0.1

# The address people use to open the app, e.g. https://files.example.com.
# Used in the bot's welcome message, and turns on secure cookies when it starts with https.
PUBLIC_URL=

# Set to 1 when running behind a reverse proxy (nginx, Caddy, Cloudflare Tunnel…)
# so sign-in prompts show the visitor's real IP address.
TRUST_PROXY=

# The database (your folder list) is backed up to Telegram as a pinned file after changes,
# and restored from it when the server starts with an empty disk (needed on Render's free plan).
# Backups go to BACKUP_CHAT_ID, else TELEGRAM_STORAGE_CHAT_ID, else the first allowed user's chat.
BACKUP=on
BACKUP_CHAT_ID=

# Keeps free hosts that sleep when idle awake by visiting the app every few minutes.
# On Render this is automatic. Elsewhere, set KEEP_ALIVE_URL to the app's public address.
KEEP_ALIVE=on
KEEP_ALIVE_URL=
KEEP_ALIVE_MINUTES=10

# Where the SQLite database (folder structure, sessions, API keys) is kept.
# Back this folder up: the files live in Telegram, but this is the index that finds them.
DATA_DIR=data

# Optional: largest upload allowed, in MB. 0 = no limit.
MAX_UPLOAD_MB=0

# Advanced: a self-hosted Telegram Bot API server (github.com/tdlib/telegram-bot-api)
# raises Telegram's limits so files are split into far fewer parts (CHUNK_SIZE_MB up to 1990).
TELEGRAM_API_BASE=https://api.telegram.org
CHUNK_SIZE_MB=18
